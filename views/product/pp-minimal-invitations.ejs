<section class="product-section pt-5">
  <div class="inner-wrapper container">
    <div class="row align-items-start">
      <!-- Left: Image Gallery -->
      <div class="col-md-6">
        <div class="product-gallery">
          <img id="mainImage" src="/images/products/vellee-min-invitations-1.png" alt="Картички с имена за маса"
            class="main-image">

          <div class="thumbnail-row">
            <img src="/images/products/vellee-min-invitations-1.png" alt="thumb2" class="thumb active" onclick="changeImage(this)">
            <img src="/images/products/vellee-min-invitations-2.png" alt="thumb2" class="thumb" onclick="changeImage(this)">
            <img src="/images/products/vellee-min-invitations-3.png" alt="thumb2" class="thumb" onclick="changeImage(this)">
            <img src="/images/products/vellee-min-invitations-4.png" alt="thumb2" class="thumb" onclick="changeImage(this)">
            <img src="/images/products/vellee-min-invitations-5.png" alt="thumb2" class="thumb" onclick="changeImage(this)">
            
          </div>
        </div>
      </div>

      <!-- Right: Product Info -->
      <div class="col-md-6 product-info">
        <div>
          <h3 class="font-cormorant fw-bold">Покани "Минимализъм"</h3>
          <p><strong>Персонализирани черно-бели, двустранни покани за сватба.</strong></p>
          <p>Поканите са двустранни и се принтират върху висококачествена хартия.</p>

          <p>Материал: хартия<br>
            Срок за изработка: <strong>12 работни дни</strong>
          </p>

          <p><strong class="text-semibold custom-design">Персонализиран дизайн</strong><br>
            Шрифтът може да се промени.<br>
            Може да се добавят и черно-бели декорации по ваш избор.
          </p>
        </div>

        <div class="price my-3">
          <strong>1,60 лв./ 0.82 €/ бр.</strong>
          <p class="price-disclaimer">За поръчки над 100 бр. цената е 1,50 лв./ 0.77 € за брой.<br>
            *Цената е само за поканите, без пликове</p>
          <a href="/contact?subject=<%= encodeURIComponent('Покани Минимализъм') %>" class="event-button font-montserrat">Изпратете запитване →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="quote-section">
  <div class="quote-inner">
    <img src="/images/icons/fireworks-icon.svg" alt="Sparkles Icon" class="quote-icon" />
    <h2 class="quote-text">Създадено от нас, вдъхновено от вас.</h2>
    <div class="quote-signature">
      <span class="dash">—</span>
      <div class="signature-lines">
        <img src="/images/icons/logo-vellee.svg" alt="Logo Icon" />
      </div>
    </div>
  </div>
</section>