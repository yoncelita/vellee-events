<section class="product-section pt-5">
  <div class="inner-wrapper container">
    <div class="row align-items-start">
      <!-- Left: Image Gallery -->
      <div class="col-md-6">
        <div class="product-gallery">
          <img id="mainImage" src="/images/products/vellee-events-wedding-newspaper-1.png" alt="Сватбен вестник"
            class="main-image">

          <div class="thumbnail-row">
            <img src="/images/products/vellee-events-wedding-newspaper-1.png" alt="thumb1" class="thumb active"
              onclick="changeImage(this)">
            <img src="/images/products/vellee-events-wedding-newspaper-2.png" alt="thumb2" class="thumb"
              onclick="changeImage(this)">
            <img src="/images/products/vellee-events-wedding-newspaper-3.png" alt="thumb3" class="thumb"
              onclick="changeImage(this)">
            <img src="/images/products/vellee-events-wedding-newspaper-4.png" alt="thumb4" class="thumb"
              onclick="changeImage(this)">
            <img src="/images/products/vellee-events-wedding-newspaper-5.png" alt="thumb5" class="thumb"
              onclick="changeImage(this)">
          </div>
        </div>
      </div>

      <!-- Right: Product Info -->
      <div class="col-md-6 product-info">
        <div>
          <h3 class="font-cormorant fw-bold">Сватбен вестник</h3>
          <p><strong>Персонализиран вестник за вашето събитие.</strong></p>
          <p>Сватбеният вестник на Vellee е перфектният спътник за вашия специален ден – с любовни цитати, график на
            сватбения ден и красиви истории за младоженците. Той превръща всяка сватба в още по-емоционално и
            незабравимо преживяване..</p>

          <p>Размери: 30х38 см (сгънат)<br>
            60х38 см (разгънат)
          <p>Материал: хартия<br>
            Срок за изработка: <strong>12 работни дни</strong>
          </p>

          <p><strong class="text-semibold custom-design">Персонализиран дизайн</strong>
        </div>

        <div class="price my-3">
          <strong>2 лв./ 1.02 € / бр.</strong>
          <p class="price-disclaimer">+ еднократно 30 лв./15.34 €/ за дизайн</p>
          <a href="/contact?subject=<%= encodeURIComponent('Сватбен вестник') %>"
            class="event-button font-montserrat">Изпратете запитване →</a>

        </div>

      </div>
    </div>
  </div>
</section>

<section class="quote-section">
  <div class="quote-inner">
    <img src="/images/icons/fireworks-icon.svg" alt="Sparkles Icon" class="quote-icon" />
    <h2 class="quote-text">Създадено от нас, вдъхновено от вас.</h2>
    <div class="quote-signature">
      <span class="dash">—</span>
      <div class="signature-lines">
        <img src="/images/icons/logo-vellee.svg" alt="Logo Icon" />
      </div>
    </div>
  </div>
</section>