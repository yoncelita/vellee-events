<section class="product-section pt-5">
  <div class="inner-wrapper container">
    <div class="row align-items-start">
      <!-- Left: Image Gallery -->
      <div class="col-md-6">
        <div class="product-gallery">
          <img id="mainImage" src="/images/products/vellee-menu-1-1.png" alt="Картички с имена за маса"
            class="main-image">

          <div class="thumbnail-row">
            <img src="/images/products/vellee-menu-1-1.png" alt="thumb1" class="thumb active"
              onclick="changeImage(this)">
            <img src="/images/products/vellee-menu-1-2.png" alt="thumb2" class="thumb" onclick="changeImage(this)">
            <img src="/images/products/vellee-menu-1-3.png" alt="thumb3" class="thumb" onclick="changeImage(this)">
            <img src="/images/products/vellee-menu-1-4.png" alt="thumb4" class="thumb" onclick="changeImage(this)">
          </div>
        </div>
      </div>

      <!-- Right: Product Info -->
      <div class="col-md-6 product-info">
        <div>
          <h3 class="font-cormorant fw-bold">Сватбено меню "Минимализъм"</h3>
          <p><strong>Персонализирани черно-бели, едностранни менюта за сватба.</strong></p>
          <p>Хартиеното меню е изискан акцент за всяка сватбена маса – създава се спрямо индивидуалното меню за
            сватбата.
            Отпечатано върху висококачествена хартия, то се превръща в част от цялостната атмосфера на тържеството.</p>

          <p>Размери на хартията: 8x22 см<br>
            Материал: хартия<br>
            Срок за изработка: <strong>12 работни дни</strong>
          </p>

          <p><strong class="text-semibold custom-design">Персонализиран дизайн</strong><br>
            Шрифтът може да се промени.<br>
            Може да се добавят и черно-бели декорации по ваш избор.
          </p>
        </div>

        <div class="price my-3">
          <strong>1,00 лв./ 0,51 € / бр.</strong>
          <a href="/contact?subject=<%= encodeURIComponent('Сватбено меню Минимализъм') %>" class="event-button font-montserrat">Изпратете запитване →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="quote-section">
  <div class="quote-inner">
    <img src="/images/icons/fireworks-icon.svg" alt="Sparkles Icon" class="quote-icon" />
    <h2 class="quote-text">Създадено от нас, вдъхновено от вас.</h2>
    <div class="quote-signature">
      <span class="dash">—</span>
      <div class="signature-lines">
        <img src="/images/icons/logo-vellee.svg" alt="Logo Icon" />
      </div>
    </div>
  </div>
</section>