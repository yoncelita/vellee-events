<section class="product-section pt-5">
  <div class="inner-wrapper container">
    <div class="row align-items-start">
      <!-- Left: Image Gallery -->
      <div class="col-md-6">
        <div class="product-gallery">
          <img id="mainImage" src="/images/products/vellee-table-cards-1.png" alt="Картички с имена за маса"
            class="main-image">

          <div class="thumbnail-row">
            <img src="/images/products/vellee-table-cards-1.png" alt="thumb1" class="thumb active"
              onclick="changeImage(this)">
            <img src="/images/products/vellee-table-cards-2.png" alt="thumb2" class="thumb"
              onclick="changeImage(this)">
            <img src="/images/products/vellee-table-cards-3.png" alt="thumb3" class="thumb"
              onclick="changeImage(this)">
            <img src="/images/products/vellee-table-cards-4.png" alt="thumb4" class="thumb"
              onclick="changeImage(this)">
            <img src="/images/products/vellee-table-cards-5.png" alt="thumb5" class="thumb"
              onclick="changeImage(this)">
          </div>
        </div>
      </div>

      <!-- Right: Product Info -->
      <div class="col-md-6 product-info">
        <div>
          <h3 class="font-cormorant fw-bold">Картички с имена за маса</h3>
          <p><strong>Персонализирани картички с имена и сушен портокал за маса.</strong></p>
          <p>Имената се отпечатват върху висококачествена релефна хартия, която се прикрепя към сушения портокал с цветна панделка или конопено въженце.</p>

          <p>Размери на хартията: 7x2 см<br>
            Материал: релефна хартия и сушен портокал<br>
            Срок за изработка: <strong>14 работни дни</strong>
          </p>

          <p><strong class="text-semibold custom-design">Персонализиран дизайн</strong><br>
            Шрифтът може да се промени.<br>
            Цветът на панделката е по ваш избор.
          </p>
        </div>

        <div class="price my-3">
          <strong>1,40 лв./ 0,72 € / бр.</strong>
          <p class="price-disclaimer">За поръчки над 100 бр. цената е 1,30 лв./ 0,66 € за брой.</p>
          <a href="/contact?subject=<%= encodeURIComponent('Картички с имена за маса') %>" class="event-button font-montserrat">Изпратете запитване →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="quote-section">
  <div class="quote-inner">
    <img src="/images/icons/fireworks-icon.svg" alt="Sparkles Icon" class="quote-icon" />
    <h2 class="quote-text">Създадено от нас, вдъхновено от вас.</h2>
    <div class="quote-signature">
      <span class="dash">—</span>
      <div class="signature-lines">
        <img src="/images/icons/logo-vellee.svg" alt="Logo Icon" />
      </div>
    </div>
  </div>
</section>
