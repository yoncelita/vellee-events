<section class="product-section pt-5">
  <div class="inner-wrapper container">
    <div class="row align-items-start">
      <!-- Left: Image Gallery -->
      <div class="col-md-6">
        <div class="product-gallery">
          <img id="mainImage" src="/images/products/vellee-guest-table-1.png" alt="Картички с имена за маса"
            class="main-image">

          <div class="thumbnail-row">
            <img src="/images/products/vellee-guest-table-1.png" alt="thumb1" class="thumb active"
              onclick="changeImage(this)">
            <img src="/images/products/vellee-guest-table-2.png" alt="thumb2" class="thumb" onclick="changeImage(this)">
            <img src="/images/products/vellee-guest-table-3.png" alt="thumb3" class="thumb" onclick="changeImage(this)">
            <img src="/images/products/vellee-guest-table-4.png" alt="thumb4" class="thumb" onclick="changeImage(this)">
          </div>
        </div>
      </div>

      <!-- Right: Product Info -->
      <div class="col-md-6 product-info">
        <div>
          <h3 class="font-cormorant fw-bold">Разпределително табло</h3>
          <p><strong>Персонализирано разпределително табло с местата на гостите.</strong></p>
          <p>Разпределителното табло за гостите е не само практично, но и стилен акцент на вашата сватба или събитие.
            Изработва се персонализирано спрямо списъка и може да бъде цветно и декорирано, така че да се впише в
            цялостната визия на празника.</p>

          <p>Размери: 90x70 см<br>
            Материал: пенокартон<br>
            Срок за изработка: <strong>12 работни дни</strong>
          </p>

          <p><strong class="text-semibold custom-design">Персонализиран дизайн</strong><br>
            Шрифтът може да се промени.<br>
            Може да се добавят и цветни декорации по ваш избор.
          </p>
        </div>

        <div class="price my-3">
          <strong>55 лв./ 28.12 € / бр.</strong>
          <a href="/contact?subject=<%= encodeURIComponent('Разпределително табло') %>" class="event-button font-montserrat">Изпратете запитване →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="quote-section">
  <div class="quote-inner">
    <img src="/images/icons/fireworks-icon.svg" alt="Sparkles Icon" class="quote-icon" />
    <h2 class="quote-text">Създадено от нас, вдъхновено от вас.</h2>
    <div class="quote-signature">
      <span class="dash">—</span>
      <div class="signature-lines">
        <img src="/images/icons/logo-vellee.svg" alt="Logo Icon" />
      </div>
    </div>
  </div>
</section>