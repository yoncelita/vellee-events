<section class="product-section pt-5">
  <div class="inner-wrapper container">
    <div class="row align-items-start">
      <!-- Left: Image Gallery -->
      <div class="col-md-6">
        <div class="product-gallery">
          <img id="mainImage" src="/images/products/vellee-guest-presents-1.png" alt="Картички с имена за маса"
            class="main-image">

          <div class="thumbnail-row">
            <img src="/images/products/vellee-guest-presents-1.png" alt="thumb2" class="thumb active"
              onclick="changeImage(this)">
            <img src="/images/products/vellee-guest-presents-2.png" alt="thumb2" class="thumb"
              onclick="changeImage(this)">
            <img src="/images/products/vellee-guest-presents-3.png" alt="thumb2" class="thumb"
              onclick="changeImage(this)">
            <img src="/images/products/vellee-guest-presents-4.png" alt="thumb2" class="thumb"
              onclick="changeImage(this)">
            <img src="/images/products/vellee-guest-presents-5.png" alt="thumb2" class="thumb"
              onclick="changeImage(this)">

          </div>
        </div>
      </div>

      <!-- Right: Product Info -->
      <div class="col-md-6 product-info">
        <div>
          <h3 class="font-cormorant fw-bold">Подаръчета Семенца</h3>
          <p><strong>Персонализирани опаковки и семена по избор.</strong></p>
          <p>Семенцата са прекрасен подарък, който вашите гости ще имат възможност да засеят и отгледат сами.
            Може да избирате между семена босилек, мента, риган, салвия.
            Панделката на шишенцето също е по избор и може да бъде цветна сатенена лента или конопено въженце.</p>

          <p>Материал: хартия и стъкло<br>
            Срок за изработка: <strong>14 работни дни</strong>
          </p>

          <p><strong class="text-semibold custom-design">Персонализиран дизайн</strong><br>
            Шрифтът може да се промени.<br>
            Декорациите и цветовете на картончето са по ваш избор.
          </p>
        </div>

        <div class="price my-3">
          <strong>2,60 лв./ 1.33 €/ бр.</strong>
          <a href="/contact?subject=<%= encodeURIComponent('Подаръчета Семенца') %>" class="event-button font-montserrat">Изпратете запитване →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="quote-section">
  <div class="quote-inner">
    <img src="/images/icons/fireworks-icon.svg" alt="Sparkles Icon" class="quote-icon" />
    <h2 class="quote-text">Създадено от нас, вдъхновено от вас.</h2>
    <div class="quote-signature">
      <span class="dash">—</span>
      <div class="signature-lines">
        <img src="/images/icons/logo-vellee.svg" alt="Logo Icon" />
      </div>
    </div>
  </div>
</section>