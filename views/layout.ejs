    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document.body.classList.add("loaded");

            document.querySelectorAll('a[href]').forEach(link => {
                link.addEventListener('click', e => {
                    const href = link.getAttribute('href');
                    if (href && !href.startsWith('#') && !href.startsWith('mailto') && !href.startsWith('tel')) {
                        e.preventDefault();
                        document.body.classList.remove('loaded');
                        setTimeout(() => window.location.href = href, 250);
                    }
                });
            });
        });
    </script>


    <script>

        // Slider
        new Swiper('.testimonials-swiper', {
            loop: true,
            centeredSlides: false,
            spaceBetween: 30,
            slidesPerView: 1,
            autoplay: {
                delay: 3000,
                disableOnInteraction: false,
            },
            pagination: {
                el: '.swiper-pagination',
                clickable: true,
            },
            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
            },
            breakpoints: {
                768: {
                    slidesPerView: 2,
                },
                1024: {
                    slidesPerView: 3,
                },
                1440: {
                    slidesPerView: 3,
                }
            }
        });


        // Slider
        new Swiper('.index-swiper', {
            loop: true,
            centeredSlides: false,
            spaceBetween: 0,
            slidesPerView: 1,
            autoplay: {
                delay: 3000,
                disableOnInteraction: false,
            },
            pagination: {
                el: '.swiper-pagination',
                clickable: true,
            },
            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
            },

        });




        const swiper = new Swiper(".reviews-swiper", {
            loop: true,
            slidesPerView: 1,
            spaceBetween: 20,
            pagination: {
                el: '.swiper-paginationn',
                clickable: true,
            },
            navigation: {
                nextEl: '.swiper-button-nextt',
                prevEl: '.swiper-button-prevv',
            },
            autoplay: {
                delay: 6000,
                disableOnInteraction: false,
            },
            breakpoints: {
                768: { slidesPerView: 2 },
                1024: { slidesPerView: 3 },
            },
        });



        document.addEventListener('DOMContentLoaded', function () {
            const offcanvasEl = document.getElementById('offcanvasNavbar');
            const bsOffcanvas = bootstrap.Offcanvas.getOrCreateInstance(offcanvasEl);

            const navLinks = offcanvasEl.querySelectorAll('.nav-link');
            navLinks.forEach(link => {
                link.addEventListener('click', () => {
                    bsOffcanvas.hide();
                });
            });
        });


        // Highlight active nav link (desktop + mobile)
        document.addEventListener('DOMContentLoaded', () => {
            const navLinks = document.querySelectorAll('.nav-link');
            const currentPath = window.location.pathname;
            const currentHash = window.location.hash;

            navLinks.forEach(link => {
                link.classList.remove('active');

                const linkPath = link.pathname;
                const linkHash = link.hash;

                // Match exact section or page
                if (
                    (linkPath === currentPath && linkHash === currentHash) ||
                    (currentPath === '/' && !currentHash && linkPath === '/' && !linkHash)
                ) {
                    link.classList.add('active');
                }

                // Handle manual clicks
                link.addEventListener('click', function () {
                    navLinks.forEach(l => l.classList.remove('active'));
                    this.classList.add('active');
                });
            });
        });




        // JavaScript Email Validation
        document.getElementById('contactForm').addEventListener('submit', function (event) {
            const nameField = document.getElementById('name');
            const emailField = document.getElementById('email');
            const nameError = document.getElementById('nameError');
            const emailError = document.getElementById('emailError');

            let isValid = true;

            // Regex for name (only letters and spaces)
            const nameRegex = /^[A-Za-z\s]+$/;

            if (!nameRegex.test(nameField.value.trim())) {
                isValid = false;
                nameError.classList.remove('d-none');
            } else {
                nameError.classList.add('d-none');
            }

            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

            if (!emailRegex.test(emailField.value.trim())) {
                isValid = false;
                emailError.classList.remove('d-none');
            } else {
                emailError.classList.add('d-none');
            }

            if (!isValid) {
                event.preventDefault();
            }
        });


        function changeImage(thumbnail) {
            const mainImage = document.getElementById('mainImage');
            const allThumbs = document.querySelectorAll('.thumb');

            allThumbs.forEach(thumb => thumb.classList.remove('active'));
            thumbnail.classList.add('active');
            mainImage.src = thumbnail.src;
        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const track = document.querySelector('.slider-track');
            const slides = document.querySelectorAll('.slide');
            const prevBtn = document.querySelector('.prev');
            const nextBtn = document.querySelector('.next');
            const sliderWindow = document.querySelector('.slider-window');

            let index = 0;

            function getSlideWidth() {
                const slide = slides[0];
                const gap = parseInt(window.getComputedStyle(track).gap) || 0;
                return slide.offsetWidth + gap;
            }

            function getVisibleCount() {
                const slideWidth = getSlideWidth();
                return Math.floor(sliderWindow.offsetWidth / slideWidth);
            }

            function moveSlider() {
                const slideWidth = getSlideWidth();
                track.style.transform = `translateX(-${index * slideWidth}px)`;
                track.style.transition = 'transform 0.6s ease-in-out';
            }

            function updateButtons() {
                const visibleCount = getVisibleCount();
                prevBtn.style.opacity = index === 0 ? '0.4' : '1';
                nextBtn.style.opacity = index >= slides.length - visibleCount ? '0.4' : '1';
                prevBtn.style.pointerEvents = index === 0 ? 'none' : 'auto';
                nextBtn.style.pointerEvents = index >= slides.length - visibleCount ? 'none' : 'auto';
            }

            nextBtn.addEventListener('click', () => {
                const visibleCount = getVisibleCount();
                if (index < slides.length - visibleCount) {
                    index++;
                    moveSlider();
                }
                updateButtons();
            });

            prevBtn.addEventListener('click', () => {
                if (index > 0) {
                    index--;
                    moveSlider();
                }
                updateButtons();
            });

            window.addEventListener('resize', () => {
                moveSlider();
                updateButtons();
            });

            updateButtons();
        });
    </script>


